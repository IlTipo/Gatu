{
  "expo": {
    "name": "Morso",
    "slug": "morso",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "morso",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.morso",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.morso",
      "adaptiveIcon": {
        "backgroundColor": "#E0592A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "lang": "it",
      "name": "Morso",
      "shortName": "Morso",
      "description": "Salva ricette e ristoranti dai social e trasformali in pasti e uscite vere.",
      "themeColor": "#E0592A",
      "backgroundColor": "#FBF7F2"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#16110D",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-localization",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Morso usa la tua posizione solo per mostrarti quanto distano i locali che hai salvato."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Morso usa le foto che scegli tu per leggere le ricette.",
          "cameraPermission": "Morso usa la fotocamera per fotografare le ricette."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
