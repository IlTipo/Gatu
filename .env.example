# Copia questo file in ".env" e inserisci i valori del tuo progetto Supabase
# (Supabase → Project Settings → API Keys / Data API).
#
# Queste due chiavi sono PUBBLICHE: possono stare nell'app perché i dati
# sono protetti dalle regole RLS del database.
# NON mettere mai qui chiavi segrete (service_role, Claude, Google Places).

EXPO_PUBLIC_SUPABASE_URL=https://il-tuo-progetto.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
